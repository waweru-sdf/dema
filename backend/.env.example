# Copy this file to .env and fill in the values.

# Long random string. Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Database (SQLite file in ./instance by default). Example for PostgreSQL:
# DATABASE_URL=postgresql+psycopg://user:password@localhost/clinic
# DATABASE_URL=

# Only needed if the frontend is hosted on a different domain from this API
# CORS_ORIGINS=https://www.drfeyseldermatology.com

# Clinic schedule
CLINIC_TIMEZONE=Africa/Addis_Ababa
# Monday=0 ... Sunday=6
OPEN_WEEKDAYS=0,1,2,3,4,5
APPOINTMENT_SLOTS=08:30,09:00,09:30,10:00,10:30,11:00,11:30,12:00,14:00,14:30,15:00,15:30,16:00,16:30
BRANCH_SLOT_CAPACITY=3
MAX_DAYS_AHEAD=90

# First staff login for /admin (created automatically on start-up if missing)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Email notifications. Option A: Brevo HTTPS API (works on Render's free plan)
BREVO_API_KEY=

# Option B: SMTP (blocked on Render's free plan; fine locally or on paid hosting)
# Gmail: use an App Password, MAIL_SERVER=smtp.gmail.com, MAIL_PORT=587, MAIL_USE_TLS=true
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SENDER=Dr. Feysel Dermatology <no-reply@drfeyseldermatology.com>
CLINIC_NOTIFY_EMAIL=Feyselclinic@gmail.com
SEND_PATIENT_CONFIRMATION=true

RATE_LIMIT_PER_HOUR=10

# Production
SESSION_COOKIE_SECURE=false
BEHIND_PROXY=false
FLASK_DEBUG=1
