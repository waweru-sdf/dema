{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Dema site (Flask)",
      "type": "debugpy",
      "request": "launch",
      "module": "flask",
      "cwd": "${workspaceFolder}/backend",
      "env": { "FLASK_APP": "wsgi.py", "FLASK_DEBUG": "1" },
      "args": ["run", "--no-debugger"],
      "jinja": true
    }
  ]
}
